# Normalize line endings: Git stores text with LF, checks out native on each OS.
* text=auto

# Force LF for files that should stay LF everywhere (tooling / cross-platform).
*.ts   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf

# Git hooks are shell scripts — CRLF breaks them on macOS/Linux.
.husky/* text eol=lf

# Windows-specific scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.ogg  binary
*.wav  binary
*.m4a  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
