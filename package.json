{
  "name": "phasergame",
  "version": "0.1.1",
  "description": "Phaser 4 + Vite + TypeScript base template (Hello World)",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "keywords": [
    "phaser",
    "phaser4",
    "vite",
    "typescript",
    "template",
    "game"
  ],
  "license": "MIT",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
